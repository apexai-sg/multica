# --- Dependencies ---
FROM node:22-alpine AS deps

WORKDIR /app

# Copy workspace config and every package.json the Aurora dependency graph
# resolves. Aurora imports core/ui/views/nextjs, and views in turn depends on
# plugin-sdk, so all of those manifests must be present for the frozen workspace
# install to link their workspace: protocol dependencies.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/aurora/package.json apps/aurora/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/views/package.json packages/views/
COPY packages/nextjs/package.json packages/nextjs/
COPY packages/plugin-sdk/package.json packages/plugin-sdk/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
# Root pnpm patchedDependencies is read even without the mobile workspace.
COPY apps/mobile/patches/ apps/mobile/patches/

RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate
RUN pnpm install --frozen-lockfile

# --- Build ---
FROM node:22-alpine AS builder

WORKDIR /app

# Activate the same pnpm version declared by the repository before the
# offline frozen install validates package-manager metadata in pnpm-lock.yaml.
COPY package.json ./
RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate

# Copy installed dependencies (preserves pnpm symlink structure)
COPY --from=deps /app ./

# Copy source
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/aurora/ apps/aurora/
COPY packages/ packages/

# Re-link after source overlay (fixes any symlinks overwritten by COPY)
RUN pnpm install --frozen-lockfile --offline

# Aurora ships no public/ directory today; create it so the runtime COPY below
# has a stable source path and adding assets later needs no Dockerfile change.
RUN mkdir -p apps/aurora/public

ENV STANDALONE=true

# Build the Aurora app (standalone output for minimal runtime)
RUN pnpm --filter @multica/aurora build

# --- Runtime ---
FROM node:22-alpine AS runner

WORKDIR /app

# Alpine openssl security fixes (CVE-2026-63073, CVE-2026-75803).
# Floor pins the fix so the build fails instead of silently shipping the CVEs.
# Remove once node:22-alpine includes libssl3 >= 3.5.8-r0.
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output (includes traced node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/aurora/.next/standalone ./
# Copy static files (not included in standalone)
COPY --from=builder --chown=nextjs:nodejs /app/apps/aurora/.next/static ./apps/aurora/.next/static
# Copy public assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/aurora/public ./apps/aurora/public
# Ship the license and attribution notices with the image (LICENSE condition 1b)
COPY --chown=nextjs:nodejs LICENSE NOTICE ./

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/aurora/server.js"]
